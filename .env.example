PGHOST=192.168.2.192
PGPORT=5432
PGDATABASE=cluster_metrics
PGUSER=metrics_reader
PGPASSWORD=

# bot-api-server origin, no path. Leave empty to keep the dashboard open with no sign-in.
# https is accepted. http is accepted only for localhost, 127.0.0.1, and ::1
# unless BOT_API_ALLOW_INSECURE_HTTP=1 (tailnet dev only).
BOT_API_URL=

# Set to 1 to allow a non-loopback http:// API URL. Tailnet dev only.
BOT_API_ALLOW_INSECURE_HTTP=

# Comma-separated authorize_url hostnames. Compared to the parsed hostname. Default: accounts.google.com
BOT_API_OAUTH_AUTHORIZE_HOSTS=
